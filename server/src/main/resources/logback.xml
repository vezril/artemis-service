<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging configuration. Two console appenders, selected by the LOG_FORMAT env var:

    json  one single-line JSON object per event (logstash-logback-encoder), for the
          constellation observability stack (Loki) + the self-healing feedback loop.
          The shipped container image sets LOG_FORMAT=json (added with the Docker
          packaging — Artemis has no image yet, so the default below stays `text`).
    text  human-readable console — the default for local `sbt run` / tests.

  The JSON schema is constellation-wide so queries resolve identically across services:
  @timestamp, level, logger_name, thread_name, message, service, stack_trace (on error),
  and any MDC entries as top-level fields. `service` = artemis.
-->
<configuration>

  <property name="LOG_APPENDER" value="${LOG_FORMAT:-text}"/>

  <appender name="text" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <!-- [%X{correlationId}] surfaces the request-tracing id locally too (empty when none). -->
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} [%thread] [%X{correlationId:-}] - %msg%n</pattern>
    </encoder>
  </appender>

  <appender name="json" class="ch.qos.logback.core.ConsoleAppender">
    <!-- MDC entries (incl. correlationId) are promoted to top-level JSON fields automatically. -->
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <customFields>{"service":"artemis"}</customFields>
    </encoder>
  </appender>

  <!--
    Verbosity is env-configurable without a rebuild (request-tracing): LOG_LEVEL sets the root
    (all libraries), LOG_LEVEL_ARTEMIS independently raises Artemis's OWN code — e.g. TRACE the
    service while keeping Pekko at INFO. Both default to INFO.
  -->
  <logger name="me.cference.artemis" level="${LOG_LEVEL_ARTEMIS:-INFO}"/>

  <root level="${LOG_LEVEL:-INFO}">
    <appender-ref ref="${LOG_APPENDER}"/>
  </root>

</configuration>
